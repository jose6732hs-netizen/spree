# Copie este arquivo para .env.local e configure com seus valores

# ==========================================
# BANCO DE DADOS
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/spree_saas
DIRECT_URL=postgresql://postgres:password@localhost:5432/spree_saas

# ==========================================
# REDIS (CACHE E SESSIONS)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# NEXT.JS
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# ==========================================
# AUTENTICAÇÃO
# ==========================================
JWT_SECRET=sua-chave-secreta-muito-longa-e-aleatoria-use-openssl-rand-base64-32
SESSION_SECRET=outra-chave-secreta-muito-longa-e-aleatoria-use-openssl-rand-base64-32

# ==========================================
# EMAIL (OPCIONAL - PARA NOTIFICAÇÕES)
# ==========================================
SMTP_HOST=smtp.seumail.com
SMTP_PORT=587
SMTP_USER=seu-email@seumail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=noreply@seudominio.com

# ==========================================
# STRIPE (OPCIONAL - PARA PAGAMENTOS)
# ==========================================
STRIPE_PUBLIC_KEY=pk_test_sua_chave_publica
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta

# ==========================================
# MEILISEARCH (BUSCA - OPCIONAL)
# ==========================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=seu-api-key

# ==========================================
# AWS S3 (OPCIONAL - PARA UPLOADS)
# ==========================================
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=sua-access-key
AWS_SECRET_ACCESS_KEY=sua-secret-key
AWS_S3_BUCKET=seu-bucket-name

# ==========================================
# VARIÁVEIS FEATURE FLAGS
# ==========================================
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_REVIEWS=false
